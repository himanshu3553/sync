---
import Icon from './Icon.astro';

// The four outcome tiles, mapped to the lifecycle stages the section above
// walks through: activation, adoption (fewer tickets), training cost, and the
// always-current guarantee that makes the first three durable.
const benefits = [
  {
    icon: 'activation' as const,
    title: 'Higher activation',
    body: 'New users are guided from inside your product and reach the moment it proves its value on day one — instead of getting stuck during setup or abandoning a page they don’t understand.',
  },
  {
    icon: 'tickets' as const,
    title: 'Fewer support tickets',
    body: 'The how-do-I questions answer themselves, so your team keeps its time for the conversations that actually need a human.',
  },
  {
    icon: 'inapp' as const,
    title: 'Lower content cost',
    body: 'Stop hand-building tours, help articles, videos and SOPs in separate tools. One recording generates all of them — from the same approved source.',
  },
  {
    icon: 'onboard' as const,
    title: 'Always up to date',
    body: 'When your product changes, re-record the flow once — and every surface updates together. No stale docs, no outdated videos, no tour pointing at a button that moved.',
  },
];
---

<section class="border-y border-gray-100 bg-paper">
  <div class="mx-auto max-w-[1140px] px-5 py-12 md:px-8 md:py-16">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Why it pays off</p>
      <h2 class="display-section">Built for the metrics you already care about</h2>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        benefits.map((b) => (
          <div class="flex items-start gap-5 rounded-card border border-gray-100 bg-white p-7 shadow-card">
            <Icon name={b.icon} />
            <div>
              <h3 class="text-[1.05rem] font-bold tracking-tight text-ink">{b.title}</h3>
              <p class="mt-2.5 text-[0.9rem] leading-relaxed text-gray-600">{b.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
