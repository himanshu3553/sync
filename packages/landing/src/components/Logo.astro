---
// The FlowBuddy mark. Source of truth: docs/design_system/assets/logo-mark.png
// (derived from FlowBuddyAI_logo.png); /logo-mark.png is a 256px copy of it.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<img
  src="/logo-mark.png"
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  class="inline-block shrink-0 select-none"
  style={`width:${size}px;height:${size}px`}
  decoding="async"
/>
