---
// The category page: the Application Intelligence Layer, explained the way the
// homepage did before the 2026-08-24 outcome repositioning. The homepage now
// sells the outcomes; this page owns the category claim, the definitional
// AEO content, and the layer-in-your-stack explainer — the hero here keeps the
// category H1 and the layer-language captions on the shared diagram verbatim.
import Base from '../layouts/Base.astro';
import AiButton from '../components/AiButton.astro';
import HeroPipeline from '../components/HeroPipeline.astro';
import LayerConcept from '../components/LayerConcept.astro';
import SignupCta from '../components/SignupCta.astro';
import { capabilityByKey } from '../data/capabilities';

// Every consumer of the layer, in one glance. Statuses follow the copy
// guardrail (docs/product/landing-page.md §1): agent execution is BETA,
// third-party agent access stays direction-only — never written as available.
const consumers = [
  { key: 'assistant', title: capabilityByKey.assistant.title, short: capabilityByKey.assistant.short, href: capabilityByKey.assistant.slug, pill: 'Live' },
  { key: 'guidance', title: capabilityByKey.guidance.title, short: capabilityByKey.guidance.short, href: capabilityByKey.guidance.slug, pill: 'Live' },
  { key: 'walkthrough', title: capabilityByKey.walkthrough.title, short: capabilityByKey.walkthrough.short, href: capabilityByKey.walkthrough.slug, pill: 'Live' },
  { key: 'agent', title: capabilityByKey.agent.title, short: capabilityByKey.agent.short, href: capabilityByKey.agent.slug, pill: 'Beta' },
  { key: 'videos', title: 'Autogenerated Product Videos', short: 'A branded, narrated video for every approved workflow.', pill: 'Live' },
  { key: 'sop', title: 'Step-by-Step SOPs', short: 'Your workflows as clean, numbered training documents.', pill: 'Live' },
  { key: 'portal', title: 'Autogenerated Help Portal', short: 'Approved workflows, published as a searchable help site.', pill: 'Live' },
  { key: 'agents', title: 'Third-Party Agent Access', short: 'Outside AI agents reading your approved knowledge to use your product correctly.', pill: 'In development' },
];

const paths: Record<string, string> = {
  assistant: 'M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z',
  guidance: 'M5 3l6 17 2.6-6.9L20.5 10z',
  walkthrough: 'M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01',
  agent: 'M13 2 3 14h7l-1 8 10-12h-7z',
  videos: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M10 8.5l5.5 3.5-5.5 3.5z',
  portal: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18m0 0c2.4 2.4 3.6 5.5 3.6 9s-1.2 6.6-3.6 9m0-18C9.6 5.4 8.4 8.5 8.4 12s1.2 6.6 3.6 9M3.5 9h17M3.5 15h17',
  sop: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h4',
  agents: 'M7 7h10v10H7zM10 3v2M14 3v2M10 19v2M14 19v2M3 10h2M3 14h2M19 10h2M19 14h2',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://flowbuddyai.com/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'The Application Intelligence Layer',
      item: 'https://flowbuddyai.com/application-intelligence-layer',
    },
  ],
};
---

<Base
  title="The Application Intelligence Layer for your SaaS | FlowBuddy AI"
  description="FlowBuddy learns how your SaaS works and turns it into an application intelligence layer — a new layer in your stack that understands your workflows, screens and concepts, and powers every user-facing surface from one approved source."
  path="/application-intelligence-layer"
  jsonLd={[breadcrumbJsonLd]}
>
  <!-- The category hero — the homepage hero as it shipped 2026-08-17, verbatim. -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      style="background:
        radial-gradient(55rem 32rem at 85% -12%, rgba(59, 80, 224, 0.08), transparent 60%),
        radial-gradient(45rem 30rem at -8% 30%, rgba(59, 80, 224, 0.05), transparent 55%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto flex max-w-[1140px] flex-col px-5 pb-8 pt-10 md:px-8 md:pt-12">
      <div class="my-auto">
        <div class="mx-auto max-w-[880px] text-center">
          <h1 class="display-hero">
            <span class="hero-ai hero-ai-static text-[1.06em]">Application</span>
            <span class="hero-ai hero-ai-static text-[1.06em]">Intelligence</span>
            <span class="hero-ai hero-ai-static text-[1.06em]"
              >Layer<svg viewBox="0 0 24 24" aria-hidden="true" class="hero-ai-spark hero-ai-spark-lg">
                <defs>
                  <linearGradient id="fb-sg-h1" x1="18%" y1="0%" x2="82%" y2="100%">
                    <stop offset="0" stop-color="#4a63e8"></stop>
                    <stop offset="1" stop-color="#3a50dd"></stop>
                  </linearGradient>
                </defs>
                <path
                  d="M10 3c.8 4.2 2.2 5.6 6.4 6.4-4.2.8-5.6 2.2-6.4 6.4-.8-4.2-2.2-5.6-6.4-6.4 4.2-.8 5.6-2.2 6.4-6.4Z"
                  fill="url(#fb-sg-h1)"></path>
                <path
                  d="M18.8 13.5c.5 2.4 1.2 3.2 3.7 3.7-2.4.5-3.2 1.2-3.7 3.7-.5-2.4-1.2-3.2-3.7-3.7 2.4-.5 3.2-1.2 3.7-3.7Z"
                  fill="url(#fb-sg-h1)"></path>
              </svg></span
            ><br /> <span class="text-[0.78em]">for your SaaS</span>
          </h1>
          <p class="lead mx-auto mt-6 max-w-2xl">
            FlowBuddy learns how your software works and turns that knowledge into an intelligence
            layer for your users and AI agents.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="https://app.flowbuddyai.com/signup" class="btn-primary">Get started free</a>
            <AiButton id="hero" />
          </div>
        </div>

        <HeroPipeline
          caption1="Record your product once"
          caption2="The Application Intelligence Layer"
          caption3="Multiple Use Cases"
          cardTitle="Application Intelligence Layer"
          cardSub="Your workflow knowledge base"
        />
      </div>
      <p class="eyebrow mt-10 text-center lg:pt-8">
        Go live in 30 minutes · No credit card required
      </p>
    </div>
  </section>

  <LayerConcept />

  <!-- The definitional AEO content: the category question, answered in prose. -->
  <section class="border-b border-gray-100">
    <div class="mx-auto max-w-[820px] px-5 py-12 md:px-8 md:py-16">
      <p class="eyebrow mb-4">The definition</p>
      <h2 class="display-section">What is an application intelligence layer?</h2>
      <div class="mt-5 space-y-4 text-[0.98rem] leading-relaxed text-gray-600">
        <p>
          An <strong class="font-bold text-ink">application intelligence layer</strong> is a layer
          that sits on top of a software product and understands how the product itself works — its
          workflows (how things get done), its concepts (what things are), and its screens (where a
          user is). Where the data, API and UI layers make a product <em>function</em>, the
          intelligence layer makes it <em>understood</em> — by the people using it and by the AI
          acting on their behalf.
        </p>
        <p>
          FlowBuddy builds that layer from one recorded walkthrough. You show it your product the
          way you’d show a new teammate; it turns the session into structured workflows, concepts
          and screen knowledge; and nothing goes live until you’ve reviewed and approved it. The
          same approved layer then powers every surface — onboarding, in-app answers, contextual
          guidance, agent execution, videos and documentation — so they never drift apart, and a
          product change means updating one layer, not five tools.
        </p>
      </div>
    </div>
  </section>

  <!-- Every consumer of the one layer, at a glance. -->
  <section class="border-b border-gray-100 bg-paper">
    <div class="mx-auto max-w-[1140px] px-5 py-12 md:px-8 md:py-16">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">One layer, every consumer</p>
        <h2 class="display-section">Everything the layer powers</h2>
        <p class="lead mt-4">
          One recording, one approved layer — and every surface below reads from it.
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          consumers.map((c) => {
            const inner = (
              <>
                <div class="flex items-start justify-between gap-2">
                  <span
                    class={`grid size-9 shrink-0 place-items-center rounded-tile ${
                      c.pill === 'In development' ? 'bg-gray-100 text-gray-400' : 'bg-brand-50 text-brand-500'
                    }`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <path d={paths[c.key]} />
                    </svg>
                  </span>
                  <span
                    class={`shrink-0 rounded-pill border px-2 py-0.5 font-mono text-[0.52rem] font-bold uppercase tracking-wider ${
                      c.pill === 'In development'
                        ? 'border-gray-150 bg-white text-gray-500'
                        : 'border-brand-100 bg-brand-50 text-brand-600'
                    }`}
                  >
                    {c.pill}
                  </span>
                </div>
                <h3 class={`mt-3 text-[0.98rem] font-bold leading-snug tracking-tight ${c.pill === 'In development' ? 'text-gray-500' : 'text-ink'}`}>
                  {c.title}
                </h3>
                <p class="mt-1.5 text-[0.82rem] leading-relaxed text-gray-500">{c.short}</p>
              </>
            );
            return c.href ? (
              <a href={c.href} class="rounded-card border border-gray-100 bg-white p-5 shadow-card transition-colors hover:border-brand-200">
                {inner}
              </a>
            ) : (
              <div class={`rounded-card border p-5 ${c.pill === 'In development' ? 'border-gray-150 bg-paper-2' : 'border-gray-100 bg-white shadow-card'}`}>
                {inner}
              </div>
            );
          })
        }
      </div>
      <p class="mt-8 text-[0.86rem] leading-relaxed text-gray-500">
        AI Agent Execution is in beta and off by default — every run needs your user’s consent.
        Third-party agent access is in development and not yet available — <a
          href="/future"
          class="font-semibold text-brand-500 hover:underline">see the road ahead</a
        >.
      </p>
    </div>
  </section>

  <SignupCta />
</Base>
