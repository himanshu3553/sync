---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import KnowledgeBase from '../components/KnowledgeBase.astro';
import Benefits from '../components/Benefits.astro';
import SignupCta from '../components/SignupCta.astro';
import Faq from '../components/Faq.astro';
import { faqs } from '../data/faqs';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="FlowBuddy AI — Record your product once. Let AI help your users."
  description="Record your product once — FlowBuddy learns how it works and turns that knowledge into an in-app AI assistant, interactive walkthroughs, product videos and step-by-step guides, always in sync with your product. Live in 30 minutes."
  path="/"
  jsonLd={[faqJsonLd]}
>
  <Hero />
  <KnowledgeBase />
  <HowItWorks />
  <Benefits />
  <SignupCta />
  <Faq />
</Base>
