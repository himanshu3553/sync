---
// "How it works" — the secondary CTA, linking to the homepage's
// how-it-works section (it replaced the widget-opening "See it in action";
// Base.astro's data-open-copilot handler is currently unused). Two variants:
// default (white sections — gradient border, brand text) and light (on the
// indigo CTA panel — white on tint).
interface Props {
  /** Kept for call-site compatibility — the sparkle svg it namespaced is gone. */
  id: string;
  variant?: 'default' | 'light';
}
const { variant = 'default' } = Astro.props;
---

<a href="/#how-it-works" class:list={['btn-ai', variant === 'light' && 'btn-ai-light']}>
  How it works
</a>
