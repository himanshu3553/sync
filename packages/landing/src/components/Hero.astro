---
// Hero: the outcome-first claim (founder repositioning 2026-08-24) — buyers
// bounced off the category language, so the homepage now leads with the USP in
// buyer words ("record once → onboard, guide, help") and the category story
// lives intact on /application-intelligence-layer. Centered claim, then the
// shared three-beat flow diagram (HeroPipeline) with buyer-language captions.
// The H1 is soft off-black (display-hero's ink) on the founder's call — no
// gradient text and no twinkle spark (founder removed it) —
// the diagram already SHOWS record-once-use-everywhere, so only its words
// changed.
import AiButton from './AiButton.astro';
import HeroPipeline from './HeroPipeline.astro';
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(55rem 32rem at 85% -12%, rgba(59, 80, 224, 0.08), transparent 60%),
      radial-gradient(45rem 30rem at -8% 30%, rgba(59, 80, 224, 0.05), transparent 55%);"
    aria-hidden="true"
  >
  </div>
  <!-- On lg+ the hero fills the first viewport (minus the 62px header) and the
       caption is pinned to its bottom edge; below lg it flows naturally. -->
  <div
    class="relative mx-auto flex max-w-[1140px] flex-col px-5 pb-8 pt-10 md:px-8 md:pt-12 lg:min-h-[calc(100vh-62px)]"
  >
    <div class="my-auto">
      <div class="mx-auto max-w-[880px] text-center">
        <h1 class="display-hero">
          Record your product once,<br />
          Let AI help your users.
        </h1>
        <p class="lead mx-auto mt-6 max-w-2xl">
          FlowBuddy learns how your application works and turns that knowledge into an in-app AI
          assistant, interactive walkthroughs, product videos and step-by-step guides. Always in
          sync with your product.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="https://app.flowbuddyai.com/signup" class="btn-primary">Get started free</a>
          <AiButton id="hero" />
        </div>
      </div>

      <HeroPipeline
        caption1="Record your product once"
        caption2="FlowBuddy learns it"
        caption3="It powers every user surface"
        cardTitle="Your Product Knowledge"
        cardSub="Every workflow, learned from your recording"
      />
    </div>
    <p class="eyebrow mt-10 text-center lg:mt-auto lg:pt-8">
      Go live in 30 minutes · No credit card required
    </p>
  </div>
</section>
