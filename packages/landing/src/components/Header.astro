---
import Logo from './Logo.astro';
---

<!-- Flat at the very top of the page — no line, no surface, the content sits
     straight on the hero. Once scrolled it becomes a floating rounded capsule
     (white surface, hairline border, soft shadow, detached from the top edge).
     The MARKUP is the scrolled capsule and the script only adds .is-top, so
     no-JS still gets a legible header over any section. -->
<header class="fb-header sticky top-0 z-40 px-3 pt-2.5 md:px-4" data-header>
  <div
    class="fb-headbar mx-auto flex h-[62px] max-w-[1140px] items-center justify-between rounded-pill border border-gray-150 bg-white/95 px-5 shadow-card backdrop-blur md:px-8"
  >
    <a href="/" class="flex items-center gap-2.5" aria-label="FlowBuddy AI home">
      <Logo size={30} />
      <span class="text-[1.05rem] font-extrabold tracking-tight text-ink">FlowBuddy AI</span>
    </a>
    <div class="flex items-center gap-3">
      <a
        href="https://app.flowbuddyai.com"
        class="hidden text-[0.9rem] font-semibold text-gray-600 transition-colors hover:text-ink sm:block"
        >Sign in</a
      >
      <a
        href="https://app.flowbuddyai.com/signup"
        class="btn-primary !px-5 !py-2.5 !text-[0.88rem]"
        >Get started free</a
      >
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    if (!header) return;
    const paint = () => header.classList.toggle('is-top', window.scrollY < 8);
    paint();
    addEventListener('scroll', paint, { passive: true });
  })();
</script>
